<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <AssemblyName>page-yield</AssemblyName>
    <RootNamespace>BinaryPaper.Recovery.PageYield</RootNamespace>
    <Description>Measures how many codes each reading strategy recovers from a corpus of page images. Not shipped.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../cli/src/BinaryPaper.Recovery/BinaryPaper.Recovery.csproj" />
  </ItemGroup>

</Project>
