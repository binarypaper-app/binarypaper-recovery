<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Sources are cleared and then pinned to nuget.org only.

       This is deliberate and load-bearing for a public recovery kit: it guarantees the build
       never silently picks up a private or machine-local feed, which is a release requirement.
       Anyone cloning this repository builds from exactly the same public packages. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
