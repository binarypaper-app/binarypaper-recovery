<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <!-- Globalization data is REQUIRED, not optional. The capsule format normalizes passwords to
         Unicode NFC, and with InvariantGlobalization=true String.Normalize does not compose. A
         build without ICU silently fails to open any capsule whose password was typed in a
         decomposed form, with no diagnostic the user could act on. -->
    <InvariantGlobalization>false</InvariantGlobalization>

    <!-- No telemetry, no implicit network calls, reproducible where the toolchain allows. -->
    <Deterministic>true</Deterministic>

    <!-- Overridden by tools/build-release.ps1 with the release version. The default says plainly
         that a build is not a release, because the alternative default is 1.0.0, and a development
         build claiming to be the first release is exactly the confusion this tool cannot afford. -->
    <Version>0.0.0-dev</Version>

    <Authors>BinaryPaper</Authors>
    <Company>BinaryPaper</Company>
    <Copyright>Copyright 2026 BinaryPaper</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
  </PropertyGroup>
</Project>
