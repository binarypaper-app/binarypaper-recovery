<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>BinaryPaper.Recovery.ImageVectors</RootNamespace>
    <AssemblyName>image-vectors</AssemblyName>
    <Description>Generates the image conformance vectors. Test tooling; not shipped.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- The fixture *encoder*. Deliberately not the decoder under test: a vector suite says more
         when the encoder that produced a fixture is not the reader being checked against it.
         Test tooling, never shipped, and absent from the release SBOM. -->
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BinaryPaper.Recovery\BinaryPaper.Recovery.csproj" />
  </ItemGroup>

</Project>
