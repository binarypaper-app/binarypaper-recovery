<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>BinaryPaper.Recovery</RootNamespace>
    <Description>Recovery-only implementation of the BinaryPaper capsule protocol.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- The page pipeline's geometry helpers are implementation detail, but they are exactly the
         part worth testing directly: a vector can only reach them through a whole page. -->
    <InternalsVisibleTo Include="BinaryPaper.Recovery.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BinaryPaper.Recovery.Codecs\BinaryPaper.Recovery.Codecs.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Argon2id. AES-GCM, SHA-256 and ZIP come from the framework. -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2" />
    <!-- LZMA decode for the legacy .lzma alone container. Decode only; this tool never writes. -->
    <PackageReference Include="SharpCompress" Version="0.49.1" />
    <!-- PNG/JPEG decode to raw pixels. Pure managed port of stb_image.h, no dependencies and no
         native binaries. -->
    <PackageReference Include="StbImageSharp" Version="2.30.16" />
    <!-- QR detection and decoding: the zxing-cpp project's own .NET binding, and the same upstream
         decoder the BinaryPaper Android restorer uses. This one carries native assets, for the six
         RIDs tools/build-release.ps1 publishes; a platform outside that matrix has to build
         zxing-cpp itself. That cost was taken deliberately, because the managed alternative reads
         no version-40 symbol out of a photographed page at all. -->
    <PackageReference Include="ZXingCpp" Version="0.5.3" />
  </ItemGroup>

</Project>
